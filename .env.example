# ============================================================
#  MomoTalk 后端配置文件（复制本文件为 .env 后修改）
#  cp .env.example .env
# ============================================================

# ---- 服务端口（ECS 安全组要放行这个端口）----
PORT=3000

# ---- MySQL 数据库连接（部署手册步骤2里创建的数据库）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=momotalk
DB_PASSWORD=改成你的MySQL密码
DB_NAME=momotalk
# 数据库是否强制 TLS：云数据库（TiDB Cloud / 云 MySQL）填 true，本机或内网 MySQL 填 false
# TiDB Cloud Serverless 必须填 true，否则连接被拒绝
DB_SSL=false

# ---- 安全配置 ----
# 令牌签名密钥：必须改成32位以上随机字符串（防止伪造登录令牌）
SECRET=CHANGE…_32+

# 本服务对外访问地址（用于拼接上传文件/小程序页面的完整 URL）
# 填你 ECS 的公网IP或域名，例如 http://47.98.123.45:3000 或 https://api.你的域名.com
PUBLIC_BASE_URL=http://127.0.0.1:3000

# ---- 文件上传 ----
# 上传文件保存目录（聊天图片/文件/头像/小程序包都存这里）
UPLOAD_DIR=./uploads
# 单个文件大小上限（MB）
MAX_UPLOAD_MB=50

# ---- 可选：消息推送（个推 REST API）----
# 说明：uni-push 2.0 底层就是个推。不填这三项 = 关闭推送，
#       客户端「轮询兜底」照常自动收消息（前台实时、后台打开即见），不影响任何功能。
# 想开推送：到个推官网 https://console.getui.com 创建应用（包名与客户端一致），
# 拿到 AppID / AppKey / MasterSecret 填进来即可，客户端无需改代码。
PUSH_APPID=
PUSH_APPKEY=
PUSH_M…RET=
